# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Postgres + pgvector) -----------------------------------------
DATABASE_URL=postgresql://superstar:superstar@localhost:5432/superstar

# --- Redis (Celery broker + cache) ------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- LLM (open-weight only) -------------------------------------------------
# Dev default: Ollama serving Qwen 2.5 7B Instruct Q4_K_M.
# Prod: point at a vLLM-served Qwen 2.5 32B AWQ endpoint.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_TIMEOUT_SECONDS=120

# vLLM example (uncomment when serving from your own GPU box / RunPod):
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://vllm-host:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
# LLM_API_KEY=optional-bearer-token

# --- Embeddings (BGE-M3, local) ---------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# --- Decisioning thresholds -------------------------------------------------
DECISIONING_CONFIDENCE_THRESHOLD=0.85
DECISIONING_SHADOW_MODE=true

# --- Tenant config directory ------------------------------------------------
# SuperStar reads tenant-specific KB, form schemas, approval chains from here.
# DO NOT commit this directory into the SuperStar repo.
SUPERSTAR_CONFIG_DIR=./examples/kb-it-access

# --- Storage ----------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/tmp/superstar-storage
# AWS_S3_BUCKET=
# AWS_REGION=

# --- CORS -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email (Phase 4 — leave disabled for v0) --------------------------------
EMAIL_ENABLED=false
# SMTP_HOST=localhost
# SMTP_PORT=1025

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
# SENTRY_DSN=
